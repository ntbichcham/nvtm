# Copy file này thành .env rồi chỉnh đường dẫn cho đúng máy.
# Không commit .env lên Git.

# Checkpoint thật, đặt ngoài thư mục public htdocs.
MODEL_CHECKPOINT_PATH=D:/Ct255-NVTM(BI)/nhom2/ABSA_Project/models/best_phobert_absa.pt

# Thư mục chứa model_phobert.py và dataset_loader.py.
MODEL_CODE_DIR=D:/Ct255-NVTM(BI)/nhom2/ABSA_Project/src

TOKENIZER_NAME=vinai/phobert-base

# 128 khớp với cấu hình đánh giá/test đã công bố.
MAX_LEN=128

# auto | cpu | cuda
DEVICE=auto

# vncorenlp: đúng pipeline huấn luyện.
# raw: chỉ dùng smoke test, KHÔNG dùng cho kết quả chính thức.
SEGMENTER_BACKEND=vncorenlp

VNCORENLP_DIR=D:/Ct255-NVTM(BI)/nhom2/ABSA_Project/models/vncorenlp

# JDK 17 portable đã cài trong giai đoạn 3.
JAVA_HOME=D:/Ct255-NVTM(BI)/tools/jdk-17

# Để trống khi chạy local. Đặt một chuỗi bí mật khi deploy.
API_KEY=

# Dùng cache Hugging Face local, không tải lại PhoBERT.
HF_LOCAL_FILES_ONLY=true

# Thời gian chờ tối đa cho một request suy luận.
REQUEST_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO

# Tùy chọn: ghi đè version hiển thị, ví dụ phobert_official_ep5
MODEL_VERSION=